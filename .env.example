# Virtual Coworker — Stage 1 paid Search pilot (local env example)

# Copy to vision/.env.local (or project root) and fill real values.
# NEVER commit real secrets.

# --- Lead delivery (email / webhook) ---
LEAD_EMAIL_US=
LEAD_EMAIL_AU=
LEAD_FROM_EMAIL=
# RESEND_API_KEY=

# Optional backup / automation
LEAD_WEBHOOK_URL=
LEAD_SHEET_WEBHOOK_URL=

# Optional generic webhook labeled historically as Zoho — NOT Zoho CRM API.
# HTTP 200 ≠ zoho_synced. Counts as a durable traffic channel if monitored.
ZOHO_WEBHOOK_URL=

# --- Direct Zoho CRM V8 (server-only; CRM READY parallel track) ---
# NOT required for TRAFFIC READY / initial Maximize Clicks Enable.
# Never use NEXT_PUBLIC_* for these. Leave ENABLED=false until mapping verified.
ZOHO_CRM_ENABLED=false
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com
ZOHO_CRM_MODULE=Leads
ZOHO_CRM_SUBMISSION_ID_FIELD=VC_Submission_ID
ZOHO_CRM_TIMEOUT_MS=15000
# Optional verified custom field API names (omit = do not invent / do not send):
# ZOHO_CRM_FIELD_GCLID=
# ZOHO_CRM_FIELD_GBRAID=
# ZOHO_CRM_FIELD_WBRAID=
# ZOHO_CRM_FIELD_UTM_SOURCE=
# ZOHO_CRM_FIELD_MARKET=
# ZOHO_CRM_FIELD_CATEGORY=

# QA: accept validated leads to server logs without a delivery channel.
# TEMPORARY on Vercel production for Stage 1 form QA until real inbox is wired.
# Do NOT leave true for paid traffic. log-only ≠ durable delivery ≠ CRM sync.
ALLOW_LOG_ONLY_LEADS=false

# --- Tracking: three micro-site identities (separate containers) ---
# Do NOT assume one GTM for US + AU + PH. Leave empty until each exists.
NEXT_PUBLIC_GTM_US=
NEXT_PUBLIC_GTM_AU=
NEXT_PUBLIC_GTM_PH=
NEXT_PUBLIC_GA4_US=
NEXT_PUBLIC_GA4_AU=
NEXT_PUBLIC_GA4_PH=
# Legacy US-only fallback (ignored for AU/PH):
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Do not hard-code Ads conversion labels in app code — map in GTM from dataLayer.
# dataLayer always includes market / site_surface: us | au | ph
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_ENABLE_ADS_CONVERSIONS=false

# --- Phones ---
# US defaults to brief NA number 310-426-8776 when empty.
# AU: leave empty — form-primary, no fake phone placeholder.
NEXT_PUBLIC_US_PHONE=
NEXT_PUBLIC_AU_PHONE=

# Job-seeker careers destination (Stage 1 default: /ph on microsite)
# Keep inside this microsite — do not point at WordPress careers.
NEXT_PUBLIC_CAREERS_URL=/ph

# Cloudflare Turnstile — optional. If either key missing, baseline form still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Feature flags ---
NEXT_PUBLIC_PILOT_NOINDEX=true
