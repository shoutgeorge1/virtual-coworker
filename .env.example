# Virtual Coworker — Stage 1 paid Search pilot (local env example)

# Copy to vision/.env.local (or project root) and fill real values.
# NEVER commit real secrets.

# --- Lead delivery (email / webhook) ---
LEAD_EMAIL_US=
LEAD_EMAIL_AU=
LEAD_FROM_EMAIL=
# RESEND_API_KEY=

# Optional backup / automation
LEAD_WEBHOOK_URL=
LEAD_SHEET_WEBHOOK_URL=

# Optional later Zoho — do not block Stage 1 launch if empty
ZOHO_WEBHOOK_URL=

# --- Temporary pilot tracking (George-controlled) ---
# Leave empty in development so Ads conversions do not fire via GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Do not hard-code Ads conversion labels in app code — map in GTM from dataLayer.
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_ENABLE_ADS_CONVERSIONS=false

# --- Phones (optional; leave empty to show [US_BUSINESS_PHONE] / [AU_BUSINESS_PHONE]) ---
NEXT_PUBLIC_US_PHONE=
NEXT_PUBLIC_AU_PHONE=

# Job-seeker careers destination (external URL preferred; defaults to /ph)
NEXT_PUBLIC_CAREERS_URL=

# Cloudflare Turnstile — optional. If either key missing, baseline form still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Feature flags ---
NEXT_PUBLIC_PILOT_NOINDEX=true
