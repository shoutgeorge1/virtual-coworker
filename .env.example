# Virtual Coworker — paid Search pilot (local env example)

# Copy to vision/.env.local (or project root) and fill real values.
# NEVER commit real secrets.

# --- Lead delivery (Phase 1 email fallback) ---
LEAD_EMAIL_US=
LEAD_EMAIL_AU=
LEAD_FROM_EMAIL=
# Optional Resend / SMTP-style provider key (example only)
# RESEND_API_KEY=

# Optional backup / automation
LEAD_WEBHOOK_URL=
LEAD_SHEET_WEBHOOK_URL=

# Optional later Zoho
ZOHO_WEBHOOK_URL=

# --- Temporary pilot tracking (George-controlled) ---
# Leave empty in development so Ads conversions do not fire.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# Enable conversion firing only in production when explicitly set
NEXT_PUBLIC_ENABLE_ADS_CONVERSIONS=false

# --- Phones (optional; leave empty to hide tel: links) ---
NEXT_PUBLIC_US_PHONE=
NEXT_PUBLIC_AU_PHONE=

# --- Feature flags ---
NEXT_PUBLIC_PILOT_NOINDEX=true
