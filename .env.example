# Virtual Coworker — Stage 1 paid Search pilot (local env example)

# Copy to vision/.env.local (or project root) and fill real values.
# NEVER commit real secrets.

# --- Lead delivery (email / webhook) ---
# Mirror WordPress Gravity Forms (confirmed Aug 2026):
#   US → us@virtualcoworker.com · AU → apac@virtualcoworker.com
#   From WP: no-reply@virtualcoworker.com (SendGrid)
LEAD_EMAIL_US=us@virtualcoworker.com
LEAD_EMAIL_AU=apac@virtualcoworker.com
# Optional CC while priming (George monitors tests)
# LEAD_EMAIL_CC=george@shoutgeorge.com
LEAD_FROM_EMAIL=
# RESEND_API_KEY=

# Optional backup / automation
LEAD_WEBHOOK_URL=
# Optional Bearer token sent with LEAD_WEBHOOK_URL / sheet / zoho_webhook POSTs
# LEAD_WEBHOOK_AUTH=
# Pilot durable sink (private GitHub Issues) — same app /api/lead-sink
# LEAD_SINK_SECRET=
# GITHUB_LEADS_TOKEN=
# GITHUB_LEADS_REPO=shoutgeorge1/vc-employer-leads
LEAD_SHEET_WEBHOOK_URL=

# Optional generic webhook labeled historically as Zoho — NOT Zoho CRM API.
# HTTP 200 ≠ zoho_synced. Counts as a durable traffic channel if monitored.
ZOHO_WEBHOOK_URL=

# --- Direct Zoho CRM V8 (server-only; CRM READY parallel track) ---
# NOT required for TRAFFIC READY / initial Maximize Clicks Enable.
# Never use NEXT_PUBLIC_* for these.
# Production writes: ZOHO_SUBMISSION_ENABLED only. Leave false until George approves.
# ZOHO_CRM_ENABLED must stay false (legacy flag — does not enable writes).
ZOHO_SUBMISSION_ENABLED=false
ZOHO_CRM_ENABLED=false
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com
ZOHO_CRM_MODULE=Leads
ZOHO_CRM_SUBMISSION_ID_FIELD=Gravity_Form_Entry_ID
ZOHO_CRM_TIMEOUT_MS=15000
# Optional verified custom field API names (omit = do not invent / do not send):
# ZOHO_CRM_FIELD_GCLID=
# ZOHO_CRM_FIELD_GBRAID=
# ZOHO_CRM_FIELD_WBRAID=
# ZOHO_CRM_FIELD_UTM_SOURCE=
# ZOHO_CRM_FIELD_MARKET=
# ZOHO_CRM_FIELD_CATEGORY=

# QA: accept validated leads to server logs without a delivery channel.
# TEMPORARY on Vercel production for Stage 1 form QA until real inbox is wired.
# Do NOT leave true for paid traffic. log-only ≠ durable delivery ≠ CRM sync.
ALLOW_LOG_ONLY_LEADS=false

# --- Tracking: three micro-site identities (separate containers) ---
# Do NOT assume one GTM for US + AU + PH. Leave empty until each exists.
# AU create-later: ads-launch/AU-GTM-GA4-PLAYBOOK.md (Checklist #15). Never paste US or WP IDs.
NEXT_PUBLIC_GTM_US=
NEXT_PUBLIC_GTM_AU=
NEXT_PUBLIC_GTM_PH=
NEXT_PUBLIC_GA4_US=
NEXT_PUBLIC_GA4_AU=
NEXT_PUBLIC_GA4_PH=
# Legacy US-only fallback (ignored for AU/PH):
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Do not hard-code Ads conversion labels in app code — map in GTM from dataLayer.
# dataLayer always includes market / site_surface: us | au | ph
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_ENABLE_ADS_CONVERSIONS=false

# --- Phones ---
# US defaults to (888) 964-8644 when empty (verified VC US line).
# Never use 888-864-8644 or 888-954-8644.
# AU defaults to 1300 886 740 when empty (George-approved 2026-08-08).
# Override only with the real public line — do not invent placeholders.
# Display can include spaces; app builds tel:+1… / tel:+61… hrefs.
# Website tel click ≠ Ads 60s qualified call conversion.
NEXT_PUBLIC_US_PHONE=
NEXT_PUBLIC_AU_PHONE=

# Job-seeker exit → WordPress Philippines careers (leave paid employer funnel).
# Default when empty: https://virtualcoworker.com.ph
# Do not point at US/AU employer WordPress hosts.
NEXT_PUBLIC_CAREERS_URL=https://virtualcoworker.com.ph

# Cloudflare Turnstile — optional. If either key missing, baseline form still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site origin for canonical / OG / sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.virtualcoworker.app

# --- Feature flags ---
# true = force noindex sitewide (QA). Production employer SEO: false or unset.
# Page-level still noindexes thank-you, /ph exit, consult, prototype.
NEXT_PUBLIC_PILOT_NOINDEX=false
# Exit/intent popup + timed nudge (employer LPs). Hold 2026-08-14 — off unless "true".
NEXT_PUBLIC_ENABLE_EXIT_INTENT=false
# Scripted conversion chat widget (employer LPs). Hold 2026-08-14 — off unless "true".
NEXT_PUBLIC_ENABLE_CHAT=false
# Role quiz lead magnet on employer LPs. Default on unless "false".
NEXT_PUBLIC_ENABLE_ROLE_QUIZ=true

# --- X-ray Site tests scoreboard (local pull only; not a Vercel secret) ---
# Numeric GA4 property id for US measurement G-2V3V0BS6JW (Admin → Property settings).
# Used by: python3 ads-launch/pull_experiments_snapshot.py
# Script also defaults to 549075481 if unset. Needs ADC or service account Viewer.
# Do not invent AU property ids.
GA4_PROPERTY_ID=549075481
# Numeric AU property id for G-7X1K9V2LFE (Admin → Property settings — not the G- id).
# Same Viewer SA as US. Do not blend AU into US totals.
GA4_PROPERTY_ID_AU=
# Prefer service account (durable). Drop JSON at credentials/ga4-viewer-sa.json
# then set the absolute path. Do NOT use gcloud auth application-default login
# for this — Google often blocks that unverified user-OAuth flow.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/george/Developer/virtual-coworker/credentials/ga4-viewer-sa.json
