{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/launch-control", "permanent": false },
    { "source": "/checklist", "destination": "/launch-checklist", "permanent": true },
    { "source": "/checklist.html", "destination": "/launch-checklist", "permanent": true },
    { "source": "/keywords", "destination": "/keyword-strategy", "permanent": true },
    { "source": "/keywords.html", "destination": "/keyword-strategy", "permanent": true },
    { "source": "/action.html", "destination": "/launch-control", "permanent": true }
  ]
}
